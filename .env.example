# Copy this file to .env and fill in your real Supabase project values
# (Settings -> API in the Supabase dashboard). This is the SAME Supabase
# project the pacer-app web project already uses, so the native app and the
# web app read from one shared `runs` table.
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
